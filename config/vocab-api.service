[Unit]
Description=vocab-api personalized sentence service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/vocab-api
EnvironmentFile=/etc/vocab-api/vocab-api.env
ExecStart=/home/ubuntu/vocab-api/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
