# 独立站点示例：先替换域名和证书路径并签发有效证书，再运行 nginx -t；
# 如果复用现有站点，只合并相应的 server/location 配置，避免覆盖其他服务。
server {
    listen 80;
    server_name vocab.example.com;
    return 308 https://vocab.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name vocab.example.com;
    ssl_certificate /etc/letsencrypt/live/vocab.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vocab.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /vocab/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 8m;
    }
}
